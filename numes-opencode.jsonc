// OpenCode provider 配置示例 — 合并进 ~/.config/opencode/opencode.jsonc 的 "provider" 段
// Key 使用环境变量引用 {env:NUMES_API_KEY}, 不写明文 (环境变量由 .env / shell 提供)
// 注意: Numes 免费端点普遍不支持 reasoning.effort=medium, 只有 high 被全部免费端点支持,
//       因此每个模型都设了 options.reasoningEffort="high", 否则会报
//       "reasoning.effort is not supported by any endpoint for this model"
{
  "numes": {
    "name": "numes",
    "npm": "@ai-sdk/openai-compatible",
    "options": {
      "baseURL": "https://api.numes.ai/api/v1",
      "apiKey": "{env:NUMES_API_KEY}"
    },
    "models": {
      "z-ai/glm-5.3-flash:free": { "name": "glm-5.3-flash (free)", "options": { "reasoningEffort": "high" } },
      "z-ai/glm-5.3:free": { "name": "glm-5.3 (free)", "options": { "reasoningEffort": "high" } },
      "deepseek/deepseek-v4.1-flash:free": { "name": "deepseek-v4.1-flash (free)", "options": { "reasoningEffort": "high" } },
      "moonshotai/kimi-k3.1-pro:free": { "name": "kimi-k3.1-pro (free)", "options": { "reasoningEffort": "high" } },
      "nvidia/nemotron-3-ultra-550b-a55b:free": { "name": "nemotron-3-ultra (free)", "options": { "reasoningEffort": "high" } },
      "dealignai/glm-5.3-flash-uncensored-fp8:free": { "name": "glm-5.3-flash uncensored (free)", "options": { "reasoningEffort": "high" } },
      "dealignai/glm-5.3-uncensored-fp8:free": { "name": "glm-5.3 uncensored (free)", "options": { "reasoningEffort": "high" } },
      "dealignai/deepseek-v4.1-flash-uncensored-fp8:free": { "name": "deepseek-v4.1-flash uncensored (free)", "options": { "reasoningEffort": "high" } },
      "uniboshi/kimi-k3-abliterated-v1:free": { "name": "kimi-k3 abliterated (free)", "options": { "reasoningEffort": "high" } }
    }
  }
}
